<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A small local HTTP wrapper around RoomAcoustics.Core: the web front end (web/) sends a room, a source and a receiver, and gets metrics,
       decay curves and ray paths back as JSON. All the acoustics stays in Core; this project only translates. -->
  <ItemGroup>
    <ProjectReference Include="..\RoomAcoustics.Core\RoomAcoustics.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RoomAcoustics.Api</RootNamespace>
    <AssemblyName>RoomAcoustics.Api</AssemblyName>
  </PropertyGroup>

</Project>
